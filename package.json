{
  "name": "dsh-aaaaaaa",
  "version": "1.3.0",
  "private": false,
  "type": "module",
  "description": "一键恢复插件预设置：记录「能正常跑」的插件清单与设置，重置后一键写回。若重置后本插件未启动，请手动运行 ~/.dsh/aaaaaaa-watch/run.cmd。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "snapshot",
    "backup",
    "restore",
    "recovery",
    "一键恢复"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "江 + DSH",
  "repository": {
    "type": "git",
    "url": "https://github.com/916126130/dsh-aaaaaaa.git"
  },
  "bugs": {
    "url": "https://github.com/916126130/dsh-aaaaaaa/issues"
  },
  "homepage": "https://github.com/916126130/dsh-aaaaaaa#readme"
}
