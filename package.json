{
  "name": "dsh-aaaaaaa",
  "version": "1.3.1",
  "private": false,
  "type": "module",
  "description": "一键守护 · 记录可用的插件与设置，重置后一键还原。One-click guardian for DSH: snapshot a working plugin setup and restore it after a reset.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "snapshot",
    "backup",
    "restore",
    "recovery",
    "一键守护",
    "一键恢复"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "watchdog"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "江 + DSH",
  "repository": {
    "type": "git",
    "url": "https://github.com/916126130/dsh-aaaaaaa.git"
  },
  "bugs": {
    "url": "https://github.com/916126130/dsh-aaaaaaa/issues"
  },
  "homepage": "https://github.com/916126130/dsh-aaaaaaa#readme"
}
